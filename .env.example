# Docker only. Copy to .env; choose secrets locally. Never commit .env.
HOST_PORT=3141
DB_NAME=wexashelf
DB_USER=wexashelf
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Random setup key, at least 24 characters; no default or shared key.
WEXA_SETUP_KEY=
# Site URL and administrator password are entered in /install.
# Initial local URL: http://127.0.0.1:3141
# cPanel does not need this file; create storage/install.key manually instead.
